<Window x:Class="DefragSimulator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Defrag Simulator" Height="800" Width="1200"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}">
    <DockPanel>
        <!-- Top controls -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8" VerticalAlignment="Center">
            <Button x:Name="AnalyzeButton" Content="Analyze" Width="100" Click="AnalyzeButton_Click"/>
            <Button x:Name="DefragButton" Content="Defrag" Width="100" Margin="8,0,0,0" Click="DefragButton_Click"/>
            <Button x:Name="StopButton" Content="Stop" Width="100" Margin="8,0,0,0" IsEnabled="False" Click="StopButton_Click"/>

            <TextBlock Text="Grid:" Margin="24,0,4,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="GridSizeCombo" Width="120" SelectionChanged="GridSizeCombo_SelectionChanged">
                <ComboBoxItem>20×40</ComboBoxItem>
                <ComboBoxItem>25×50</ComboBoxItem>
                <ComboBoxItem>30×60</ComboBoxItem>
                <ComboBoxItem>40×90</ComboBoxItem>
            </ComboBox>

            <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Delay" VerticalAlignment="Center"/>
                <Slider x:Name="SpeedSlider" Minimum="0" Maximum="100" Width="200" Margin="8,0,0,0" ValueChanged="SpeedSlider_ValueChanged"/>
                <TextBlock x:Name="DelayLabel" Text="0 ms" VerticalAlignment="Center" Width="80" Margin="8,0,0,0"/>
            </StackPanel>

            <CheckBox x:Name="ThemeToggle" Content="Dark mode" Margin="24,0,0,0" VerticalAlignment="Center" IsChecked="True" Checked="ThemeToggle_Checked" Unchecked="ThemeToggle_Unchecked" Foreground="{DynamicResource AppForegroundBrush}"/>
        </StackPanel>

        <!-- Status bar at bottom with right-justified legend and compact progress bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource StatusBarBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: status text -->
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="Ready" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0"/>

                <!-- Right: progress + legend -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar x:Name="OverallProgress" Width="160" Height="16" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="PercentText" Text="0%" VerticalAlignment="Center" Margin="8,0,16,0"/>

                    <!-- Legend right-aligned -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Rectangle Width="14" Height="14" Fill="{DynamicResource BootCategoryBrush}"/><TextBlock Text="Boot" Margin="4,0,0,0"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Rectangle Width="14" Height="14" Fill="{DynamicResource SystemCategoryBrush}"/><TextBlock Text="System" Margin="4,0,0,0"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Rectangle Width="14" Height="14" Fill="{DynamicResource PagingCategoryBrush}"/><TextBlock Text="Paging" Margin="4,0,0,0"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Rectangle Width="14" Height="14" Fill="{DynamicResource UserCategoryBrush}"/><TextBlock Text="User" Margin="4,0,0,0"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Rectangle Width="14" Height="14" Fill="{DynamicResource MovingCategoryBrush}"/><TextBlock Text="Moving" Margin="4,0,0,0"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Rectangle Width="14" Height="14" Fill="{DynamicResource UserCategoryBrush}" Stroke="{DynamicResource FinalAccentBrush}" StrokeThickness="{DynamicResource HighlightStrokeThickness}"/><TextBlock Text="Complete" Margin="4,0,0,0"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><Rectangle Width="14" Height="14" Fill="{DynamicResource FreeCategoryBrush}" Stroke="{DynamicResource CellStrokeBrush}"/><TextBlock Text="Free" Margin="4,0,0,0"/></StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StatusBar>

        <!-- Content: scrollable uniform grid (last child fills remaining space) -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource AppBackgroundBrush}">
            <UniformGrid x:Name="CellsGrid" Rows="20" Columns="40" Margin="10"/>
        </ScrollViewer>
    </DockPanel>
</Window>