<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Dark theme resources (modern, blue-leaning) -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0E1B27"/>
  <SolidColorBrush x:Key="AppForegroundBrush" Color="#E6F1FF"/>
  <SolidColorBrush x:Key="CellStrokeBrush" Color="#1F3B52"/>
  <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#162636"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#3BA1FF"/>
  <SolidColorBrush x:Key="DangerAccentBrush" Color="#FF4D4D"/>
  <SolidColorBrush x:Key="FinalAccentBrush" Color="#46b45a"/>

  <!-- Category brushes (single source of truth) -->
  <SolidColorBrush x:Key="BootCategoryBrush" Color="#3300c2"/>
  <SolidColorBrush x:Key="SystemCategoryBrush" Color="#2194b7"/>
  <SolidColorBrush x:Key="PagingCategoryBrush" Color="#C8A03C"/>
  <SolidColorBrush x:Key="UserCategoryBrush" Color="#C35046"/>
  <SolidColorBrush x:Key="MovingCategoryBrush" Color="#D0D0D0"/>
  <SolidColorBrush x:Key="FreeCategoryBrush" Color="#00FFFFFF"/>

  <!-- Shared thickness values -->
  <sys:Double x:Key="HighlightStrokeThickness">3</sys:Double>
  <sys:Double x:Key="CellBorderThicknessDefault">0.25</sys:Double>

  <!-- Subtle button style to feel a bit more modern without heavy templating -->
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}"/>
    <Setter Property="Background" Value="#1A2A3A"/>
    <Setter Property="BorderBrush" Value="{StaticResource CellStrokeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="#22384C"/>
              <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Background" Value="#1B3044"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="16"/>
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    <Setter Property="Background" Value="#0C1A25"/>
  </Style>
</ResourceDictionary>